<Page
    x:Class="VigilEye.Dashboard.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#FF1A1A2E">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center"
          Width="420">
        <StackPanel Spacing="24">
            <!-- Header -->
            <TextBlock Text="Vigil Eye"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="White"
                       TextAlignment="Center"/>

            <TextBlock Text="Guardian Login"
                       FontSize="18"
                       Foreground="#FFCCCCD8"
                       TextAlignment="Center"/>

            <!-- Login Form -->
            <Border Background="#FF25253A"
                    CornerRadius="12"
                    Padding="24">
                <StackPanel Spacing="16">
                    <!-- Email -->
                    <TextBox Header="Email Address"
                             Text="{x:Bind ViewModel.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Email address input"/>

                    <!-- Password -->
                    <PasswordBox Header="Password"
                                 AutomationProperties.Name="Password input"/>

                    <!-- Login Button -->
                    <Button x:Name="btnLogin"
                            Command="{x:Bind ViewModel.Login}"
                            Content="Sign In"
                            HorizontalAlignment="Stretch"
                            Style="{ThemeResource AccentButtonStyle}"
                            AutomationProperties.Name="Sign in button"/>

                    <!-- Loading Indicator -->
                    <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                  Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                  HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- MFA Section -->
            <Border Background="#FF25253A"
                    CornerRadius="12"
                    Padding="24"
                    Visibility="{x:Bind ViewModel.ShowMfaPrompt, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Spacing="16">
                    <TextBlock Text="Two-Factor Authentication"
                               FontWeight="SemiBold"
                               Foreground="White"/>
                    <TextBlock Text="Enter the 6-digit code from your authenticator app"
                               FontSize="12"
                               Foreground="#FF9999A8"/>
                    <TextBox Text="{x:Bind ViewModel.MfaCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="123456"
                             MaxLength="6"
                             AutomationProperties.Name="MFA code input"/>
                    <Button x:Name="btnVerifyMfa"
                            Command="{x:Bind ViewModel.VerifyMfa}"
                            Content="Verify MFA"
                            HorizontalAlignment="Stretch"
                            Style="{ThemeResource AccentButtonStyle}"/>
                </StackPanel>
            </Border>

            <!-- Error Message -->
            <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                       Foreground="#FFFF6666"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}"/>

            <!-- Recovery Link -->
            <HyperlinkButton Content="Forgot Password?"
                             Command="{x:Bind ViewModel.RecoverAccount}"
                             Foreground="#FF7777CC"
                             HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Page>
