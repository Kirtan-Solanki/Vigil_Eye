<Page
    x:Class="VigilEye.Dashboard.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VigilEye.Dashboard.Views"
    xmlns:viewmodels="using:VigilEye.Dashboard.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid x:Name="ContentArea">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="24,16,24,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Vigil Eye"
                       FontSize="28"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Foreground="#FF1A1A2E"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="btnRefresh"
                        Command="{x:Bind ViewModel.RefreshActivityFeed}"
                        Content="Refresh"
                        Style="{ThemeResource AccentButtonStyle}"/>
                <Button x:Name="btnSearch"
                        Command="{x:Bind ViewModel.Search}"
                        Content="Search"
                        Style="{ThemeResource DefaultButtonStyle}"/>
            </StackPanel>
        </Grid>

        <!-- Filter Bar -->
        <Grid Grid.Row="1" Padding="24,4,24,12" Background="#FFF5F5FA">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="Search events..."
                     Margin="0,0,8,0"/>

            <DatePicker Grid.Column="1"
                        Header="From"
                        SelectedDate="{x:Bind ViewModel.FilterStartDate, Mode=TwoWay}"/>

            <DatePicker Grid.Column="2"
                        Header="To"
                        SelectedDate="{x:Bind ViewModel.FilterEndDate, Mode=TwoWay}"
                        Margin="8,0,0,0"/>
        </Grid>

        <!-- Activity Feed -->
        <ScrollViewer Grid.Row="2"
                      Padding="24"
                      VerticalScrollBarVisibility="Auto">
            <ListView ItemsSource="{x:Bind ViewModel.ActivityFeed}"
                      SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:ActivityItem">
                        <Border Background="White"
                                Margin="0,0,0,12"
                                CornerRadius="8"
                                Padding="16"
                                BorderBrush="#FFE0E0E8"
                                BorderThickness="1"
                                AutomationProperties.Name="{x:Bind Title}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Event Type Indicator -->
                                <Border Width="4"
                                        Height="48"
                                        Margin="0,0,12,0"
                                        CornerRadius="2">
                                    <Border.Background>
                                        <SolidColorBrush>
                                            <SolidColorBrush.Color>
                                                <Binding Path="Type" Converter="{StaticResource ActivityTypeToColorConverter}"/>
                                            </SolidColorBrush.Color>
                                        </SolidColorBrush>
                                    </Border.Background>
                                </Border>

                                <StackPanel Grid.Column="1">
                                    <!-- Title -->
                                    <TextBlock Text="{x:Bind Title}"
                                               FontWeight="SemiBold"
                                               FontSize="16"
                                               Foreground="#FF1A1A2E"
                                               AutomationProperties.Name="Event title"/>

                                    <!-- Description -->
                                    <TextBlock Text="{x:Bind Description}"
                                               FontSize="13"
                                               Foreground="#FF666680"
                                               Margin="0,4,0,4"
                                               TextWrapping="Wrap"/>

                                    <!-- Timestamp -->
                                    <TextBlock Text="{x:Bind Timestamp, Converter={StaticResource DateTimeToStringConverter}}"
                                               FontSize="11"
                                               Foreground="#FF9999A8"/>

                                    <!-- Duration (for calls) -->
                                    <TextBlock Text="{x:Bind Duration}"
                                               FontSize="11"
                                               Foreground="#FF9999A8"
                                               Visibility="{x:Bind Duration, Converter={StaticResource StringToVisibilityConverter}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </ScrollViewer>
    </Grid>
</Page>
